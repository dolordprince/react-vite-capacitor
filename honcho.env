# Self-hosted only — points at YOUR Supabase
DB_CONNECTION_URI=postgresql+psycopg://postgres:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Route every tier through YOUR FastAPI backend's OpenAI-compatible endpoint
# instead of calling OpenRouter directly — reuses your Groq/OpenRouter/Cerebras
# fallback chain from llm_client.py
LLM_OPENAI_API_KEY=internal-not-checked

DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=google/gemini-2.5-flash-lite
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=http://localhost:8000/v1

SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=google/gemini-2.5-flash-lite
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=http://localhost:8000/v1

DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=google/gemini-2.5-flash-lite
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=http://localhost:8000/v1

DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=google/gemini-2.5-flash-lite
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=http://localhost:8000/v1

DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=anthropic/claude-haiku-4.5
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=http://localhost:8000/v1

DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=anthropic/claude-haiku-4.5
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=http://localhost:8000/v1

DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=z-ai/glm-5.2
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=http://localhost:8000/v1

DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=z-ai/glm-5.2
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=http://localhost:8000/v1

DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL=z-ai/glm-5.2
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=http://localhost:8000/v1

AUTH_USE_AUTH=false
NAMESPACE=dolor3v
